rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users Collection: Authenticated users can read profiles and manage their own document
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Threads & Inquiries Collection:
    // - Authenticated visitors can initiate collaboration threads
    // - Only the thread owner or portfolio admin can read and respond
    match /threads/{threadId} {
      allow create: if request.auth != null;
      allow read, update: if request.auth != null && (
        request.auth.uid == resource.data.visitorId || 
        request.auth.token.email == "rajangaur.dev@gmail.com"
      );
      allow delete: if request.auth != null && request.auth.token.email == "rajangaur.dev@gmail.com";
      
      match /messages/{messageId} {
        allow create: if request.auth != null;
        allow read: if request.auth != null && (
          request.auth.uid == get(/databases/$(database)/documents/threads/$(threadId)).data.visitorId ||
          request.auth.token.email == "rajangaur.dev@gmail.com"
        );
      }
    }
  }
}
